  "scripts": {
    "dev": "vite",
    "start:local": "env-cmd -f ./.env.local vite --port 3000",
    "build:local": "env-cmd -f ./.env.local vite build",
    "start:development": "env-cmd -f ./.env.development vite --port 3000",
    "build:development": "env-cmd -f ./.env.development vite build",
    "start:production": "env-cmd -f ./.env.production vite --port 3000",
    "build:production": "node prebuild.js & env-cmd -f ./.env.production vite build",
    "prebuild": "node prebuild.js",
    "log:development": "env-cmd -f ./.env.development node log.js",
    "start": "vite",
    "build": "node prebuild.js & vite build",
    "test:local": "env-cmd -f ./.env.local vite test",
    "test:development": "env-cmd -f ./.env.development vite test",
    "test:production": "env-cmd -f ./.env.production vite test",
    "eject": "vite eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile-sass": "node-sass --importer node_modules/node-sass-package-importer/dist/cli.js src/assets/scss/app.scss src/assets/css/app.css",
    "minify-sass": "node-sass --importer node_modules/node-sass-package-importer/dist/cli.js src/assets/scss/app.scss src/assets/css/app.min.css --output-style compressed",
    "map-sass": "node-sass --importer node_modules/node-sass-package-importer/dist/cli.js src/assets/scss/app.scss src/assets/css/app.css --source-map true",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public"
  },
  "eslintConfig": {
    "extends": "react-app",
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
