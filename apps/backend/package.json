{
  "name": "@ims/backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:local": "env-cmd -f ./.env.local nodemon -L --delay 100ms server.js",
    "start:production": "nodemon server.js",
    "start:dev": "env-cmd -f ./.env.dev nodemon server.js",
    "sync:compliance-tools:local": "env-cmd -f ./.env.local node ./scripts/syncComplianceTools.js",
    "sync:compliance-tools:dev": "env-cmd -f ./.env.dev node ./scripts/syncComplianceTools.js",
    "sync:compliance-tools:production": "node ./scripts/syncComplianceTools.js",
    "reinit:defra-factors:local": "env-cmd -f ./.env.local node ./scripts/reinitiateDefraFactors.js",
    "reinit:defra-factors:dev": "env-cmd -f ./.env.dev node ./scripts/reinitiateDefraFactors.js",
    "reinit:defra-factors:production": "node ./scripts/reinitiateDefraFactors.js",
    "recalc:emissions:local": "env-cmd -f ./.env.local node ./scripts/recalculateCCEmissions.js",
    "recalc:emissions:dev": "env-cmd -f ./.env.dev node ./scripts/recalculateCCEmissions.js",
    "recalc:emissions:production": "node ./scripts/recalculateCCEmissions.js",
    "tick:dashboard:dev": "env-cmd -f ./.env.dev nodemon tickDashboard.js",
    "tick:dashboard:production": "env-cmd -f ./.env nodemon tickDashboard.js",
    "tick:dashboard:local": "env-cmd -f ./.env.local nodemon tickDashboard.js",
    "send:release:production:confirm": "env-cmd -f ./scripts/.env node ./scripts/sendReleaseNotes.js",
    "send:release:dev": "env-cmd -f ./scripts/.env.dev node ./scripts/sendReleaseNotes.js",
    "start": "node server.js",
    "test:dev": "env-cmd -f ./.env.dev mocha ./src/tests/**/*.js",
    "deploy": "npm install --prefix client && npm run build --prefix client",
    "migration:local": "cd ./src/migrations && node index.js",
    "cluster-cleanup": "cd migrations & node clustercleanup.js",
    "log:dev": "node logs-dev.js",
    "log:prod": "node logs-v4-prod.js",
    "sync-import-validations": "env-cmd -f ./.env.local node scripts/importValidationSync.js",
    "migrate:dev": "env-cmd -f ./.env.dev migrate-mongo up",
    "migrate": "migrate-mongo",
    "migrate:down": "env-cmd -f ./.env.dev migrate-mongo down"
  },
